# Site
# Já tem um valor padrão em lib/site.ts (https://calcula-clt.vercel.app).
# Defina esta variável apenas se o domínio final for outro.
NEXT_PUBLIC_SITE_URL=https://calcula-clt.vercel.app

# Kiwify
# O checkout já tem um valor padrão em lib/site.ts (https://pay.kiwify.com.br/6d9HiEI).
# Defina esta variável apenas se o link de checkout mudar.
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/6d9HiEI

# Resend — veja SETUP-RELATORIO-PAGO.md (opcional: sem isso, o download
# imediato no navegador ainda funciona; só o envio por e-mail fica sem efeito)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CalculaCLT <relatorio@seudominio.com.br>
